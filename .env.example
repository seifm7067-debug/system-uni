# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters (enforced at startup).
SECRET_KEY=replace_with_a_secure_random_value_min_32_chars_long
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/university_management
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1
# JSON list. Required when APP_ENVIRONMENT=production.
CORS_ORIGINS=["https://app.example.com"]
# Set true in production to refuse to start without the shared Redis limiter.
RATE_LIMIT_FAIL_CLOSED=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_DB=university_management
